---
import Site from '../layouts/Site.astro';
import { dict, html, routePaths, type Lang } from '../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const f = dict(lang).faq;
const items = f.items.map(([q, a]) => [q, html(a, lang)]);

const schema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: items.map(([q, a]) => ({
		'@type': 'Question',
		name: q,
		acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '') },
	})),
};
---

<Site lang={lang} paths={routePaths('faq')} section="faq" title={f.title} description={f.description} schema={schema}>
	<section class="page-head">
		<div class="wrap narrow">
			<h1>{f.title}</h1>
			<p class="lead" set:html={html(f.lead, lang)} />
		</div>
	</section>
	<div class="wrap narrow list">
		{
			items.map(([q, a]) => (
				<details>
					<summary>{q}</summary>
					<p set:html={a} />
				</details>
			))
		}
	</div>
</Site>

<style>
	.list {
		padding-bottom: clamp(64px, 9vw, 112px);
		display: grid;
		gap: 10px;
	}

	details {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
	}

	details[open] {
		border-color: var(--line-strong);
	}

	summary {
		cursor: pointer;
		list-style: none;
		padding: 18px 52px 18px 20px;
		font-weight: 650;
		font-size: 1.05rem;
		position: relative;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary::after {
		content: '';
		position: absolute;
		right: 22px;
		top: 50%;
		width: 9px;
		height: 9px;
		border-right: 2px solid var(--muted);
		border-bottom: 2px solid var(--muted);
		transform: translateY(-70%) rotate(45deg);
		transition: transform 0.15s;
	}

	details[open] summary::after {
		transform: translateY(-30%) rotate(-135deg);
	}

	details p {
		margin: 0;
		padding: 0 20px 20px;
		color: var(--muted);
	}
</style>
