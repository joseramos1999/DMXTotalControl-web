---
import { getCollection, render } from 'astro:content';
import Site from '../layouts/Site.astro';
import { RELEASES, dict, formatDate, routePaths, type Lang } from '../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const n = dict(lang).news;

/** Newest first: 1.10.0 after 1.9.0, a beta before its final version */
function compare(a: string, b: string) {
	return b.localeCompare(a, 'en', { numeric: true });
}

// Notes are written in Spanish (with the program) and English; the other
// languages show the English ones.
const notesLang = lang === 'es' || lang === 'en' ? lang : 'en';
const entries = (await getCollection('novedades', (e) => e.id.startsWith(`${notesLang}/`))).sort((a, b) =>
	compare(a.data.version, b.data.version),
);
const notes = await Promise.all(entries.map(async (e) => ({ entry: e, ...(await render(e)) })));
---

<Site lang={lang} paths={routePaths('news')} section="news" title={n.title} description={n.description}>
	<section class="page-head">
		<div class="wrap narrow">
			<h1>{n.title}</h1>
			<p class="lead">{n.lead}</p>
			{notesLang !== lang && <p class="muted">{n.inEnglish}</p>}
		</div>
	</section>
	<div class="wrap narrow body">
		{
			notes.map(({ entry, Content }) => (
				<article class="card prose release" id={`v${entry.data.version}`} lang={notesLang}>
					<header>
						<h2>{entry.data.title}</h2>
						<p class="date">
							{entry.data.date ? <time datetime={entry.data.date}>{formatDate(entry.data.date, lang)}</time> : n.unreleased}
						</p>
					</header>
					<Content />
				</article>
			))
		}
		<p><a href={RELEASES}>{n.all}</a></p>
	</div>
</Site>

<style>
	.body {
		padding-bottom: clamp(64px, 9vw, 112px);
		display: grid;
		gap: 20px;
	}

	.release {
		padding: clamp(22px, 4vw, 36px);
	}

	.release header {
		margin-bottom: 1.2em;
	}

	.release header h2 {
		margin: 0;
		font-size: 1.7rem;
	}

	.date {
		color: var(--faint);
		margin: 4px 0 0;
	}

	/* The notes use ### for their sections */
	.release :global(h3) {
		margin-top: 1.4em;
	}
</style>
