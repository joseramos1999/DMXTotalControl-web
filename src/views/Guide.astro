---
// A beginner guide (src/content/guias/<lang>/<guide>.md)
import { getCollection, getEntry, render } from 'astro:content';
import { Icon } from '@astrojs/starlight/components';
import Site from '../layouts/Site.astro';
import Cta from '../components/Cta.astro';
import { GUIDES, dict, guidePath, guidePaths, pageUrl, url, type Guide, type Lang } from '../i18n';

interface Props {
	lang: Lang;
	guide: Guide;
}

const { lang, guide } = Astro.props;
const l = dict(lang).learn;
const entry = await getEntry('guias', `${lang}/${guide}`);
if (!entry) throw new Error(`Falta la guía ${lang}/${guide}`);
const { Content, headings } = await render(entry);
const others = (await getCollection('guias', (e) => e.id.startsWith(`${lang}/`)))
	.filter((e) => e.id !== entry.id)
	.map((e) => ({ key: e.id.split('/')[1] as Guide, title: e.data.title }))
	.sort((a, b) => GUIDES.indexOf(a.key) - GUIDES.indexOf(b.key));

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: entry.data.title,
	description: entry.data.description,
	inLanguage: lang,
	publisher: { '@type': 'Organization', name: 'DMX Total Control' },
};
---

<Site lang={lang} paths={guidePaths(guide)} section="learn" title={entry.data.title} description={entry.data.description} schema={schema}>
	<section class="page-head">
		<div class="wrap narrow">
			<a class="back" href={pageUrl('learn', lang)}><Icon name="left-arrow" size="1em" /> {l.guideBack}</a>
			<h1>{entry.data.title}</h1>
			<p class="lead">{entry.data.description}</p>
		</div>
	</section>

	<div class="wrap narrow body">
		{
			headings.filter((h) => h.depth === 2).length > 2 && (
				<nav class="toc card" aria-label={entry.data.title}>
					<ol>
						{headings
							.filter((h) => h.depth === 2)
							.map((h) => (
								<li>
									<a href={`#${h.slug}`}>{h.text}</a>
								</li>
							))}
					</ol>
				</nav>
			)
		}
		<article class="prose">
			<Content />
		</article>

		<nav class="more card" aria-label={l.guideMore}>
			<h2>{l.guideMore}</h2>
			<ul>
				{
					others.map((o) => (
						<li>
							<a href={url(guidePath(o.key, lang))}>{o.title}</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>

	<Cta lang={lang} />
</Site>

<style>
	.back {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-bottom: 20px;
		font-weight: 600;
		text-decoration: none;
	}

	.body {
		display: grid;
		gap: 32px;
		padding-bottom: clamp(64px, 9vw, 112px);
	}

	.toc ol {
		margin: 0;
		padding-left: 1.3em;
		display: grid;
		gap: 6px;
	}

	.prose :global(h2) {
		scroll-margin-top: 88px;
	}

	.prose :global(h2:first-child) {
		margin-top: 0;
	}

	.more h2 {
		font-size: 1.2rem;
	}

	.more ul {
		margin: 0;
		padding-left: 1.2em;
		display: grid;
		gap: 8px;
	}
</style>
