---
import Site from '../layouts/Site.astro';
import { dict, html, routePaths, type Lang } from '../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const l = dict(lang).legal;
---

<Site lang={lang} paths={routePaths('legal')} title={l.title} description={l.description}>
	<section class="page-head">
		<div class="wrap narrow">
			<h1>{l.title}</h1>
		</div>
	</section>
	<div class="wrap narrow prose body">
		{
			l.sections.map((s) => (
				<section>
					<h2 id={s.id}>{s.title}</h2>
					{s.list.length > 0 && (
						<ul>
							{s.list.map((item) => (
								<li set:html={html(item, lang)} />
							))}
						</ul>
					)}
					{s.paragraphs.map((p) => (
						<p set:html={html(p, lang)} />
					))}
				</section>
			))
		}
	</div>
</Site>

<style>
	.body {
		padding-bottom: clamp(64px, 9vw, 112px);
	}

	.body section:first-child h2 {
		margin-top: 0;
	}
</style>
