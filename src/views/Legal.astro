---
import Site from '../layouts/Site.astro';
import { ISSUES, REPO, type Lang } from '../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
---

{
	lang === 'es' ? (
		<Site lang="es" route="legal" title="Aviso legal y privacidad" description="Aviso legal, privacidad, licencia y créditos de la web y del programa DMX Total Control.">
			<section class="page-head">
				<div class="wrap narrow">
					<h1>Aviso legal y privacidad</h1>
				</div>
			</section>
			<div class="wrap narrow prose body">
				<h2 id="aviso-legal">Aviso legal</h2>
				<p>
					Esta es la web del proyecto de software libre DMX Total Control. Para cualquier consulta sobre la web o el programa, escribe a través de <a href={ISSUES}>GitHub</a>.
				</p>
				<p>
					El programa se ofrece gratis y «tal cual», sin garantías, según la licencia Apache 2.0. Prueba siempre tu show con tu equipo antes de un bolo.
				</p>

				<h2 id="privacidad">Privacidad</h2>
				<ul>
					<li>Esta web no usa cookies ni pide datos personales.</li>
					<li>La sirve GitHub Pages, que como cualquier servidor registra datos técnicos de las visitas (como la dirección IP) según su propia <a href="https://docs.github.com/es/site-policy/privacy-policies/github-general-privacy-statement">declaración de privacidad</a>.</li>
					<li>Las descargas salen de GitHub. El programa no envía datos de uso: solo se conecta a internet para buscar y descargar sus actualizaciones (se puede desactivar en Opciones › Actualizaciones) y las de la Open Fixture Library.</li>
					<li>Si nos escribes en GitHub, tu mensaje es público allí: no pongas datos personales que no quieras compartir.</li>
				</ul>

				<h2 id="licencia">Licencia</h2>
				<p>
					DMX Total Control es software libre bajo la <a href={`${REPO}/blob/main/COPYING`}>licencia Apache 2.0</a>: puedes usarlo, copiarlo, modificarlo y distribuirlo, también en trabajos comerciales, conservando los avisos de copyright y de licencia. El código está en <a href={REPO}>GitHub</a>.
				</p>

				<h2 id="creditos">Créditos</h2>
				<ul>
					<li>
						El programa es una obra derivada de <a href="https://github.com/mcallegari/qlcplus">Q Light Controller Plus (QLC+)</a>, de Heikki Junnila, Massimo Callegari y los colaboradores de QLC+, bajo la licencia Apache 2.0. DMX Total Control no está afiliado ni respaldado por el proyecto QLC+; «Q Light Controller Plus» y «QLC+» son nombres de ese proyecto.
					</li>
					<li>Biblioteca de fixtures: las definiciones heredadas de QLC+ y la <a href="https://open-fixture-library.org">Open Fixture Library</a> (MIT).</li>
					<li>Interfaz hecha con <a href="https://www.qt.io">Qt</a>.</li>
					<li>Fuentes del programa: Roboto (Apache 2.0) y Font Awesome Free (SIL Open Font License 1.1). Fuente de esta web: Inter (SIL Open Font License 1.1).</li>
					<li>Web hecha con <a href="https://astro.build">Astro</a> y <a href="https://starlight.astro.build">Starlight</a>.</li>
				</ul>
				<p>Los nombres de fabricantes y productos (Enttec, Eurolite, DMXKing, Akai…) pertenecen a sus dueños y se citan solo para indicar compatibilidad.</p>
			</div>
		</Site>
	) : (
		<Site lang="en" route="legal" title="Legal notice and privacy" description="Legal notice, privacy, licence and credits of the DMX Total Control website and program.">
			<section class="page-head">
				<div class="wrap narrow">
					<h1>Legal notice and privacy</h1>
				</div>
			</section>
			<div class="wrap narrow prose body">
				<h2 id="legal-notice">Legal notice</h2>
				<p>
					This is the website of the DMX Total Control free-software project. For any question about the site or the program, write through <a href={ISSUES}>GitHub</a>.
				</p>
				<p>
					The program is offered free of charge and “as is”, without warranties, under the Apache License 2.0. Always test your show with your gear before a gig.
				</p>

				<h2 id="privacy">Privacy</h2>
				<ul>
					<li>This site uses no cookies and asks for no personal data.</li>
					<li>It is served by GitHub Pages, which, like any server, logs technical data about visits (such as the IP address) under its own <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">privacy statement</a>.</li>
					<li>Downloads come from GitHub. The program sends no usage data: it only goes online to look for and download its own updates (you can turn this off in Options › Updates) and those of the Open Fixture Library.</li>
					<li>If you write to us on GitHub, your message is public there: don’t include personal data you don’t want to share.</li>
				</ul>

				<h2 id="licence">Licence</h2>
				<p>
					DMX Total Control is free software under the <a href={`${REPO}/blob/main/COPYING`}>Apache License 2.0</a>: you can use, copy, modify and distribute it, commercially too, keeping the copyright and licence notices. The code is on <a href={REPO}>GitHub</a>.
				</p>

				<h2 id="credits">Credits</h2>
				<ul>
					<li>
						The program is a derivative work of <a href="https://github.com/mcallegari/qlcplus">Q Light Controller Plus (QLC+)</a>, by Heikki Junnila, Massimo Callegari and the QLC+ contributors, under the Apache License 2.0. DMX Total Control is not affiliated with or endorsed by the QLC+ project; “Q Light Controller Plus” and “QLC+” are names of that project.
					</li>
					<li>Fixture library: the definitions inherited from QLC+ and the <a href="https://open-fixture-library.org">Open Fixture Library</a> (MIT).</li>
					<li>Interface built with <a href="https://www.qt.io">Qt</a>.</li>
					<li>Program fonts: Roboto (Apache 2.0) and Font Awesome Free (SIL Open Font License 1.1). Website font: Inter (SIL Open Font License 1.1).</li>
					<li>Website built with <a href="https://astro.build">Astro</a> and <a href="https://starlight.astro.build">Starlight</a>.</li>
				</ul>
				<p>Manufacturer and product names (Enttec, Eurolite, DMXKing, Akai…) belong to their owners and are mentioned only to show compatibility.</p>
			</div>
		</Site>
	)
}

<style>
	.body {
		padding-bottom: clamp(64px, 9vw, 112px);
	}
</style>
