---
import { Icon } from '@astrojs/starlight/components';
import Site from '../layouts/Site.astro';
import { RELEASES, dict, fill, formatDate, formatSize, html, pageUrl, routePaths, type Lang } from '../i18n';
import { release } from '../data/release';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = dict(lang);
const d = t.download;
const { installer } = release;
const vars = { version: release.version, date: formatDate(release.date, lang), size: formatSize(installer.size, lang) };
const hashCommand = `Get-FileHash .\\${installer.name}`;
---

<Site lang={lang} paths={routePaths('download')} title={d.title} description={fill(d.description, vars)}>
	<section class="page-head">
		<div class="wrap narrow">
			<h1>{d.h1}</h1>
			<p class="lead">{d.lead}</p>
		</div>
	</section>

	<div class="wrap narrow body">
		<div class="card get">
			<div class="platform">
				<Icon name="desktop" size="1.6em" />
				<div>
					<strong>{d.platform}</strong>
					<span>{fill(t.common.versionLine, vars)}</span>
				</div>
			</div>
			<a class="btn btn-primary btn-lg" href={installer.url} download>
				<Icon name="download" size="1.2em" />
				{d.button}
			</a>
			<p class="file">{installer.name}</p>
			{
				installer.sha256 && (
					<div class="sha">
						<span>{d.sha}</span>
						<div class="sha-row">
							<code id="sha">{installer.sha256}</code>
							<button class="btn btn-ghost btn-sm" type="button" data-copy="sha" data-done={d.copied}>
								{d.copy}
							</button>
						</div>
					</div>
				)
			}
			<p class="links">
				<a href={pageUrl('news', lang, `#v${release.version}`)}>{d.notes}</a>
				<a href={RELEASES}>{d.all}</a>
			</p>
		</div>

		<div class="prose">
			<h2>{d.stepsTitle}</h2>
			<ol class="steps">
				{d.steps.map((s) => <li set:html={html(s, lang)} />)}
			</ol>

			<h2>{d.whyTitle}</h2>
			<div class="note">
				<Icon name="warning" size="1.2em" />
				<div>
					<p>{d.why}</p>
					<pre><code>{hashCommand}</code></pre>
					<p>{d.why2}</p>
				</div>
			</div>

			<h2>{d.updatesTitle}</h2>
			<p>{d.updates}</p>

			<h2>{d.needTitle}</h2>
			<ul>
				{d.need.map((n) => <li set:html={html(n, lang)} />)}
			</ul>

			<h2>{d.otherTitle}</h2>
			<p set:html={html(d.other, lang)} />
		</div>
	</div>
</Site>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
		button.addEventListener('click', async () => {
			const text = document.getElementById(button.dataset.copy!)?.textContent ?? '';
			try {
				await navigator.clipboard.writeText(text);
				const label = button.textContent;
				button.textContent = button.dataset.done ?? label;
				setTimeout(() => (button.textContent = label), 1600);
			} catch {
				// No clipboard (an old browser or no permission): the hash stays selectable.
			}
		});
	}
</script>

<style>
	.body {
		padding-bottom: clamp(64px, 9vw, 112px);
	}

	.get {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
		padding: clamp(24px, 4vw, 36px);
		background:
			radial-gradient(120% 140% at 100% 0%, rgba(61, 139, 253, 0.16), transparent 55%),
			var(--surface);
		border-color: var(--line-strong);
		margin-bottom: 24px;
	}

	.platform {
		display: flex;
		gap: 14px;
		align-items: center;
	}

	.platform div {
		display: grid;
	}

	.platform span,
	.file {
		color: var(--muted);
		font-size: 0.93rem;
	}

	.file {
		margin: -6px 0 0;
		font-family: var(--mono);
		font-size: 0.85rem;
		word-break: break-all;
	}

	.sha {
		width: 100%;
		display: grid;
		gap: 6px;
		font-size: 0.85rem;
		color: var(--faint);
	}

	.sha-row {
		display: flex;
		gap: 8px;
		align-items: center;
		flex-wrap: wrap;
	}

	.sha code {
		flex: 1 1 260px;
		min-width: 0;
		word-break: break-all;
		padding: 8px 10px;
		font-size: 0.8rem;
		color: var(--text);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		margin: 0;
		font-weight: 600;
	}

	.steps li {
		margin-bottom: 0.7em;
	}

	pre {
		margin: 0 0 1em;
		overflow-x: auto;
	}

	pre code {
		display: block;
		padding: 10px 12px;
		white-space: pre;
	}
</style>
