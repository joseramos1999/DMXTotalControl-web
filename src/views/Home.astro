---
import { Image } from 'astro:assets';
import { Icon } from '@astrojs/starlight/components';
import Site from '../layouts/Site.astro';
import { REPO, SEGMENTS, dict, fill, formatDate, formatSize, html, manualUrl, pageUrl, routePaths, segmentPath, url, type Lang } from '../i18n';
import { release } from '../data/release';
import { shot, type Shot } from '../data/shots';
import { segmentLook } from '../data/segments';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = dict(lang);
const h = t.home;
const size = formatSize(release.installer.size, lang);
const meta = fill(t.common.versionLine, { version: release.version, date: formatDate(release.date, lang), size });

// Each feature row: its screenshot and its page of the manual
const rows: { key: keyof typeof h.features; shot: Shot; page: string }[] = [
	{ key: 'live', shot: 'mixer', page: 'directo' },
	{ key: 'program', shot: 'fx', page: 'programar' },
	{ key: 'scenes', shot: 'scenes', page: 'escenas' },
	{ key: 'playbacks', shot: 'playbacks', page: 'playbacks' },
	{ key: 'show', shot: 'show', page: 'show' },
	{ key: 'patch', shot: 'patch', page: 'patch' },
];

const languages = ['Español', 'English', 'Português', 'Français', 'Italiano', 'Deutsch'];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'DMX Total Control',
	description: h.description,
	applicationCategory: 'MultimediaApplication',
	operatingSystem: 'Windows 10, Windows 11',
	softwareVersion: release.version,
	datePublished: release.date,
	downloadUrl: release.installer.url,
	fileSize: size,
	license: 'https://www.apache.org/licenses/LICENSE-2.0',
	inLanguage: ['es', 'en', 'pt', 'fr', 'it', 'de'],
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};
---

<Site lang={lang} paths={routePaths('home')} section="home" title="DMX Total Control" description={h.description} schema={schema}>
	<section class="hero">
		<div class="beams" aria-hidden="true">
			<span class="beam b1"></span>
			<span class="beam b2"></span>
			<span class="beam b3"></span>
		</div>
		<div class="wrap hero-text">
			<span class="eyebrow">{h.eyebrow}</span>
			<h1>{h.h1a} <span class="gradient-text">{h.h1b}</span></h1>
			<p class="lead">{h.lead}</p>
			<div class="actions">
				<a class="btn btn-primary btn-lg" href={pageUrl('download', lang)}>
					<Icon name="download" size="1.2em" />
					{t.common.downloadFree}
				</a>
				<a class="btn btn-ghost btn-lg" href={manualUrl(lang)}>
					<Icon name="open-book" size="1.2em" />
					{h.manual}
				</a>
			</div>
			<p class="meta">{meta}</p>
		</div>
		<div class="wrap">
			<div class="shot hero-shot">
				<Image
					src={shot(lang, 'live')}
					alt={h.heroAlt}
					widths={[640, 960, 1280, 1440]}
					sizes="(min-width: 1240px) 1200px, 100vw"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
		</div>
	</section>

	<section class="proof" aria-label={h.proofLabel}>
		<ul class="wrap">
			{h.proof.map((p) => <li>{p}</li>)}
		</ul>
	</section>

	<section class="section" id="funciones">
		<div class="wrap">
			<div class="intro">
				<span class="eyebrow">{h.featuresEyebrow}</span>
				<h2>{h.featuresTitle}</h2>
				<p class="lead">{h.featuresLead}</p>
			</div>
			<div class="features">
				{
					rows.map((r, i) => {
						const f = h.features[r.key];
						return (
							<article class={`feature ${i % 2 ? 'flip' : ''}`}>
								<div class="feature-text">
									<h3>{f.title}</h3>
									<p class="muted">{f.text}</p>
									<ul class="ticks">
										{f.points.map((p) => <li>{p}</li>)}
									</ul>
									<a class="more" href={manualUrl(lang, r.page)}>
										{t.common.inManual} <Icon name="right-arrow" size="1em" />
									</a>
								</div>
								<div class="shot">
									<Image src={shot(lang, r.shot)} alt={f.alt} widths={[480, 800, 1100]} sizes="(min-width: 1040px) 700px, 100vw" />
								</div>
							</article>
						);
					})
				}
			</div>
			<div class="actions start">
				<a class="btn btn-ghost" href={pageUrl('features', lang)}>{h.allFeatures} <Icon name="right-arrow" size="1em" /></a>
			</div>
		</div>
	</section>

	<section class="section alt">
		<div class="wrap">
			<div class="intro">
				<span class="eyebrow">{h.whoEyebrow}</span>
				<h2>{h.whoTitle}</h2>
			</div>
			<div class="grid who-grid">
				{
					SEGMENTS.map((s) => (
						<a class="card who" href={url(segmentPath(s, lang))}>
							<span class="who-icon"><Icon name={segmentLook[s].icon} size="1.4em" /></span>
							<h3>{t.who.segments[s].card}</h3>
							<p class="muted">{t.who.segments[s].cardText}</p>
							<span class="more">{t.common.readMore} <Icon name="right-arrow" size="1em" /></span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<div class="intro">
				<span class="eyebrow">{h.hwEyebrow}</span>
				<h2>{h.hwTitle}</h2>
			</div>
			<div class="grid grid-2">
				{
					h.hw.map((c) => (
						<div class="card">
							<h3>{c.title}</h3>
							<p class="muted">{c.text}</p>
						</div>
					))
				}
			</div>
			<p class="hw-note">
				<Icon name="information" size="1.1em" />
				<span set:html={html(h.hwNote, lang)} />
			</p>
			<div class="actions start">
				<a class="btn btn-ghost" href={pageUrl('hardware', lang)}>{h.hwAll} <Icon name="right-arrow" size="1em" /></a>
			</div>
		</div>
	</section>

	<section class="section alt">
		<div class="wrap split">
			<div>
				<span class="eyebrow">{h.langEyebrow}</span>
				<h2>{h.langTitle}</h2>
				<ul class="chips">
					{languages.map((l) => <li>{l}</li>)}
				</ul>
			</div>
			<div>
				<ul class="ticks big">
					{h.langItems.map((item) => <li>{item}</li>)}
				</ul>
				<div class="actions start">
					<a class="btn btn-ghost" href={pageUrl('learn', lang)}>{h.learnLink} <Icon name="right-arrow" size="1em" /></a>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<div class="intro">
				<span class="eyebrow">{h.openEyebrow}</span>
				<h2>{h.openTitle}</h2>
			</div>
			<div class="grid grid-3">
				{
					h.open.map((o) => (
						<div class="card">
							<h3>{o.title}</h3>
							<p class="muted">{o.text}</p>
						</div>
					))
				}
			</div>
			<div class="actions start">
				<a class="btn btn-ghost" href={REPO}><Icon name="github" size="1.2em" />{h.source}</a>
				<a class="btn btn-ghost" href={pageUrl('roadmap', lang)}><Icon name="list-format" size="1.2em" />{h.roadmap}</a>
			</div>
		</div>
	</section>

	<section class="final">
		<div class="beams" aria-hidden="true">
			<span class="beam b1"></span>
			<span class="beam b3"></span>
		</div>
		<div class="wrap">
			<h2>{t.common.ctaTitle}</h2>
			<p class="lead">{t.common.ctaText}</p>
			<a class="btn btn-primary btn-lg" href={pageUrl('download', lang)}>
				<Icon name="download" size="1.2em" />
				{t.common.downloadFree}
			</a>
			<p class="meta">{meta}</p>
		</div>
	</section>
</Site>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding: clamp(56px, 9vw, 112px) 0 clamp(48px, 7vw, 88px);
	}

	.hero-text {
		position: relative;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.hero-text .lead {
		margin-inline: auto;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		justify-content: center;
		margin-top: 12px;
	}

	.meta {
		margin-top: 16px;
		font-size: 0.9rem;
		color: var(--faint);
	}

	.hero-shot {
		position: relative;
		margin-top: clamp(32px, 6vw, 64px);
		box-shadow:
			0 40px 120px -30px rgba(61, 139, 253, 0.45),
			0 30px 80px -20px rgba(0, 0, 0, 0.8);
	}

	/* Stage beams from the top of the hero */
	.beams {
		position: absolute;
		inset: 0;
		pointer-events: none;
		overflow: hidden;
		-webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 85%);
		mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 85%);
	}

	.beam {
		position: absolute;
		top: -40px;
		width: 900px;
		height: 900px;
		margin-left: -450px;
		filter: blur(18px);
		opacity: 0.55;
		transform-origin: 50% 0;
		animation: sway 14s ease-in-out infinite alternate;
	}

	.b1 {
		left: 18%;
		background: conic-gradient(at 50% 0%, transparent 0deg, transparent 166deg, rgba(61, 139, 253, 0.55) 180deg, transparent 194deg);
		--from: -14deg;
		--to: 6deg;
	}

	.b2 {
		left: 50%;
		background: conic-gradient(at 50% 0%, transparent 0deg, transparent 170deg, rgba(174, 62, 201, 0.45) 180deg, transparent 190deg);
		--from: 5deg;
		--to: -5deg;
		animation-duration: 18s;
	}

	.b3 {
		left: 82%;
		background: conic-gradient(at 50% 0%, transparent 0deg, transparent 166deg, rgba(48, 164, 108, 0.4) 180deg, transparent 194deg);
		--from: 12deg;
		--to: -8deg;
		animation-duration: 16s;
	}

	@keyframes sway {
		from {
			transform: rotate(var(--from));
		}
		to {
			transform: rotate(var(--to));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.beam {
			animation: none;
			transform: rotate(var(--from));
		}
	}

	.proof {
		border-block: 1px solid var(--line);
		background: var(--bg-raised);
	}

	.proof ul {
		list-style: none;
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px 28px;
		padding-block: 20px;
		font-weight: 600;
		font-size: 0.98rem;
	}

	.proof li {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.proof li::before {
		content: '';
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--brand);
	}

	.intro {
		max-width: 760px;
		margin-bottom: clamp(32px, 5vw, 56px);
	}

	.features {
		display: grid;
		gap: clamp(56px, 8vw, 96px);
	}

	.feature {
		display: grid;
		gap: 24px;
		align-items: center;
	}

	@media (min-width: 1040px) {
		.feature {
			grid-template-columns: 5fr 7fr;
			gap: 56px;
		}
		.feature.flip .feature-text {
			order: 2;
		}
	}

	.feature h3 {
		font-size: clamp(1.4rem, 2.4vw, 1.75rem);
	}

	.feature .ticks {
		margin: 4px 0 20px;
		color: var(--text);
		font-size: 0.97rem;
	}

	.more {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-weight: 600;
		text-decoration: none;
	}

	.more:hover {
		text-decoration: underline;
	}

	.alt {
		background: var(--bg-raised);
		border-block: 1px solid var(--line);
	}

	.who-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 12px;
		background: rgba(61, 139, 253, 0.14);
		color: var(--accent-hover);
		margin-bottom: 14px;
	}

	.card p:last-child {
		margin-bottom: 0;
	}

	.hw-note {
		display: flex;
		gap: 10px;
		align-items: flex-start;
		margin-top: 24px;
		color: var(--muted);
	}

	.hw-note :global(svg) {
		flex: none;
		margin-top: 4px;
		color: var(--accent-hover);
	}

	.split {
		display: grid;
		gap: 32px;
		align-items: center;
	}

	@media (min-width: 900px) {
		.split {
			grid-template-columns: 1fr 1fr;
			gap: 64px;
		}
	}

	.chips {
		list-style: none;
		padding: 0;
		margin: 8px 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.chips li {
		padding: 6px 14px;
		border-radius: 999px;
		background: var(--surface-2);
		border: 1px solid var(--line-strong);
		font-weight: 600;
		font-size: 0.92rem;
	}

	.ticks.big {
		gap: 16px;
		font-size: 1.05rem;
	}

	.section .actions {
		justify-content: flex-start;
		margin-top: 24px;
	}

	.actions.start {
		justify-content: flex-start;
		margin-top: 32px;
	}

	.who-grid {
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
	}

	a.card.who {
		display: flex;
		flex-direction: column;
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.15s,
			transform 0.15s;
	}

	a.card.who:hover {
		border-color: var(--line-strong);
		transform: translateY(-2px);
	}

	.who .more {
		margin-top: auto;
		color: var(--accent-hover);
	}

	.final {
		position: relative;
		overflow: hidden;
		text-align: center;
		padding: clamp(72px, 10vw, 128px) 0;
		border-top: 1px solid var(--line);
	}

	.final .wrap {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.final .lead {
		margin-bottom: 24px;
	}
</style>
