---
import logo from '../assets/logo.svg';
import { ISSUES, REPO, SEGMENTS, dict, manualUrl, pageUrl, segmentPath, url, type Lang } from '../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = dict(lang);
const f = t.footer;
const year = new Date().getFullYear();
const credits = pageUrl('legal', lang, `#${t.legal.sections[3].id}`);
---

<footer class="site-footer">
	<div class="wrap cols">
		<div class="about">
			<a class="brand" href={pageUrl('home', lang)}>
				<img src={logo.src} width="28" height="28" alt="" />
				<span>DMX Total Control</span>
			</a>
			<p>{f.about}</p>
		</div>
		<div>
			<h2>{f.program}</h2>
			<ul>
				<li><a href={pageUrl('download', lang)}>{t.nav.download}</a></li>
				<li><a href={pageUrl('features', lang)}>{t.nav.features}</a></li>
				<li><a href={pageUrl('hardware', lang)}>{t.nav.hardware}</a></li>
				<li><a href={pageUrl('news', lang)}>{t.nav.news}</a></li>
				<li><a href={pageUrl('roadmap', lang)}>{f.roadmap}</a></li>
			</ul>
		</div>
		<div>
			<h2>{t.nav.whoFor}</h2>
			<ul>
				{SEGMENTS.map((s) => <li><a href={url(segmentPath(s, lang))}>{t.who.segments[s].card}</a></li>)}
			</ul>
		</div>
		<div>
			<h2>{f.resources}</h2>
			<ul>
				<li><a href={pageUrl('learn', lang)}>{t.nav.learn}</a></li>
				<li><a href={manualUrl(lang)}>{t.nav.manual}</a></li>
				<li><a href={pageUrl('faq', lang)}>{t.nav.faq}</a></li>
				<li><a href={pageUrl('qlc', lang)}>{f.qlc}</a></li>
				<li><a href={pageUrl('press', lang)}>{f.press}</a></li>
			</ul>
		</div>
		<div>
			<h2>{f.community}</h2>
			<ul>
				<li><a href={pageUrl('contribute', lang)}>{f.contribute}</a></li>
				<li><a href={REPO}>{f.source}</a></li>
				<li><a href={ISSUES}>{f.reportBug}</a></li>
				<li><a href={pageUrl('legal', lang)}>{f.legal}</a></li>
				<li><a href={credits}>{f.credits}</a></li>
			</ul>
		</div>
	</div>
	<div class="wrap bottom">
		<p>© {year} DMX Total Control · <a href={`${REPO}/blob/main/COPYING`}>{f.licenseLine}</a></p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--line);
		background: var(--bg-raised);
		padding: 56px 0 28px;
		font-size: 0.95rem;
	}

	.cols {
		display: grid;
		gap: 32px;
		grid-template-columns: 1fr 1fr;
	}

	.about {
		grid-column: 1 / -1;
	}

	@media (min-width: 960px) {
		.cols {
			grid-template-columns: 1.6fr repeat(4, 1fr);
		}
		.about {
			grid-column: auto;
		}
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--text);
		text-decoration: none;
		font-weight: 750;
		margin-bottom: 12px;
	}

	.brand img {
		border-radius: 7px;
	}

	.about p {
		color: var(--muted);
		max-width: 24em;
	}

	h2 {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--faint);
		margin: 4px 0 14px;
	}

	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 10px;
	}

	a {
		color: var(--muted);
		text-decoration: none;
	}

	a:hover {
		color: var(--text);
	}

	.bottom {
		margin-top: 40px;
		padding-top: 20px;
		border-top: 1px solid var(--line);
		color: var(--faint);
		font-size: 0.88rem;
	}

	.bottom p {
		margin: 0;
	}

	.bottom a {
		color: var(--faint);
	}
</style>
