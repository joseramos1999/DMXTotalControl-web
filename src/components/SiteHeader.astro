---
import { Icon } from '@astrojs/starlight/components';
import logo from '../assets/logo.svg';
import { LANGS, REPO, dict, manualUrl, pageUrl, url, type Lang } from '../i18n';
import type { Section } from '../layouts/Site.astro';

interface Props {
	lang: Lang;
	paths: Record<Lang, string>;
	section: Section;
}

const { lang, paths, section } = Astro.props;
const n = dict(lang).nav;
const links = [
	{ href: pageUrl('features', lang), label: n.features, current: section === 'features' },
	{ href: pageUrl('hardware', lang), label: n.hardware, current: section === 'hardware' },
	{ href: pageUrl('learn', lang), label: n.learn, current: section === 'learn' },
	{ href: manualUrl(lang), label: n.manual, current: false },
	{ href: pageUrl('faq', lang), label: n.faq, current: section === 'faq' },
];
const languages = LANGS.map((l) => ({ lang: l, name: dict(l).meta.name, href: url(paths[l]) }));
---

<header class="site-header">
	<div class="wrap bar">
		<a class="brand" href={pageUrl('home', lang)}>
			<img src={logo.src} width="32" height="32" alt="" />
			<span>DMX Total Control</span>
		</a>
		<nav class="links" aria-label={n.menu}>
			{links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
		</nav>
		<div class="right">
			<details class="langs">
				<summary>
					<Icon name="translate" size="1.1em" />
					<span class="sr-only">{dict(lang).common.language}:</span>
					<span>{lang.toUpperCase()}</span>
				</summary>
				<ul>
					{
						languages.map((l) => (
							<li>
								<a href={l.href} hreflang={l.lang} lang={l.lang} aria-current={l.lang === lang ? 'true' : undefined}>
									{l.name}
								</a>
							</li>
						))
					}
				</ul>
			</details>
			<a class="icon" href={REPO} aria-label="GitHub"><Icon name="github" size="1.35em" /></a>
			<a class="btn btn-primary btn-sm cta" href={pageUrl('download', lang)}>
				<Icon name="download" size="1.1em" />
				{n.download}
			</a>
			<details class="menu">
				<summary aria-label={n.menu}><Icon name="bars" size="1.5em" /></summary>
				<div class="panel">
					{links.map((l) => <a href={l.href}>{l.label}</a>)}
					<a href={pageUrl('download', lang)}>{n.download}</a>
					<a href={REPO}>GitHub</a>
				</div>
			</details>
		</div>
	</div>
</header>

<script>
	// One open menu at a time, and a click outside closes it
	const menus = [...document.querySelectorAll<HTMLDetailsElement>('.site-header details')];
	document.addEventListener('click', (e) => {
		for (const d of menus) if (d.open && !d.contains(e.target as Node)) d.open = false;
	});
	for (const d of menus)
		d.addEventListener('toggle', () => {
			if (d.open) for (const other of menus) if (other !== d) other.open = false;
		});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(11, 13, 17, 0.78);
		backdrop-filter: saturate(160%) blur(14px);
		-webkit-backdrop-filter: saturate(160%) blur(14px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 24px;
		height: 64px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--text);
		text-decoration: none;
		font-weight: 750;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	.brand img {
		border-radius: 8px;
	}

	.links {
		display: none;
		gap: 2px;
	}

	.links a,
	.icon,
	.langs summary {
		color: var(--muted);
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 550;
		padding: 8px 10px;
		border-radius: 8px;
	}

	.links a:hover,
	.links a[aria-current='page'],
	.icon:hover,
	.langs summary:hover,
	.langs[open] summary {
		color: var(--text);
		background: rgba(255, 255, 255, 0.06);
	}

	.right {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.icon {
		display: none;
		align-items: center;
	}

	.cta {
		display: none;
	}

	details {
		position: relative;
	}

	summary {
		list-style: none;
		cursor: pointer;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.langs summary {
		display: flex;
		align-items: center;
		gap: 6px;
		min-height: 44px;
	}

	.langs ul {
		position: absolute;
		right: 0;
		top: calc(100% + 6px);
		list-style: none;
		margin: 0;
		padding: 6px;
		min-width: 170px;
		background: var(--surface);
		border: 1px solid var(--line-strong);
		border-radius: 12px;
		box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.7);
	}

	.langs a {
		display: block;
		padding: 9px 12px;
		border-radius: 8px;
		color: var(--text);
		text-decoration: none;
		font-weight: 550;
	}

	.langs a:hover {
		background: var(--surface-2);
	}

	.langs a[aria-current='true'] {
		color: var(--accent-hover);
	}

	.menu summary {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 10px;
		color: var(--text);
	}

	.menu {
		position: static;
	}

	.menu[open] summary {
		background: var(--surface-2);
	}

	.panel {
		position: absolute;
		left: 0;
		right: 0;
		top: 64px;
		background: var(--bg-raised);
		border-bottom: 1px solid var(--line);
		padding: 8px var(--gutter) 16px;
		display: grid;
	}

	.panel a {
		color: var(--text);
		text-decoration: none;
		font-weight: 550;
		padding: 12px 4px;
		border-bottom: 1px solid var(--line);
	}

	@media (min-width: 560px) {
		.cta {
			display: inline-flex;
		}
	}

	@media (min-width: 1040px) {
		.links,
		.icon {
			display: flex;
		}
		.menu {
			display: none;
		}
	}
</style>
