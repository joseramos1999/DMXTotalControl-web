---
// The frame of the site's own pages: head (SEO, social cards, languages),
// header and footer. The manual uses Starlight's frame instead.
import { Font } from 'astro:assets';
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { LANGS, dict, url, type Lang } from '../i18n';

export type Section = 'home' | 'features' | 'who' | 'hardware' | 'learn' | 'faq' | 'news' | 'other';

interface Props {
	lang: Lang;
	/** this page's path in every language (without the base) */
	paths: Record<Lang, string>;
	title: string;
	description: string;
	section?: Section;
	/** structured data (schema.org) for the page */
	schema?: object;
}

const { lang, paths, title, description, section = 'other', schema } = Astro.props;
const t = dict(lang);
const site = Astro.site ?? new URL('https://joseramos1999.github.io');
const absolute = (path: string) => new URL(url(path), site).href;
const canonical = absolute(paths[lang]);
const image = absolute(`/og/${lang}.png`);
const fullTitle = section === 'home' ? `DMX Total Control · ${t.common.tagline}` : `${title} · DMX Total Control`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{LANGS.map((l) => <link rel="alternate" hreflang={l} href={absolute(paths[l])} />)}
		<link rel="alternate" hreflang="x-default" href={absolute(paths.en)} />
		<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
		<link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
		<meta name="theme-color" content="#0b0d11" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="DMX Total Control" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content={t.meta.og} />
		<meta name="twitter:card" content="summary_large_image" />
		<Font cssVariable="--font-inter" preload />
		{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
	</head>
	<body>
		<a class="skip" href="#main">{t.common.skip}</a>
		<SiteHeader lang={lang} paths={paths} section={section} />
		<main id="main">
			<slot />
		</main>
		<SiteFooter lang={lang} />
	</body>
</html>
